# Internal-only build configuration for usage logging (Ben's machine only).
#
# Usage logging is an INTERNAL tuning tool, NOT a public feature. The public
# production build (CI, no env vars) ships with NO logging: the "Log my
# sessions" toggle is absent and all logging calls are inert. Only a build that
# sets BOTH variables below can log, and only to a Worker that shares the token.
#
# To run the internal build that logs your own sessions:
#   1. Copy this file to `.env.local` (gitignored) in app/.
#   2. Set VITE_USAGE_LOG_TOKEN to the same secret value you set on the Worker
#      as USAGE_LOG_TOKEN (Cloudflare:  npx wrangler secret put USAGE_LOG_TOKEN).
#   3. Run `npm run dev` (or `npm run build`) from app/.
#
# Without USAGE_LOG_TOKEN configured on the Worker, logging is off everywhere —
# even an internal build cannot write. This is the "public service has no
# logging function at all" guarantee, enforced on both ends.

VITE_ENABLE_USAGE_LOG=1
VITE_USAGE_LOG_TOKEN=replace-with-the-shared-secret
